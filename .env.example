# Copy to .env and fill in. Never commit .env.

# --- LiveKit (WebRTC transport) ---------------------------------------------
# From https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text ----------------------------------------------------------
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- LLM ---------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Text-to-speech ----------------------------------------------------------
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# --- Luma Bistro mock reservation API ---------------------------------------
# Started with: docker compose up --build  (from ./starter)
LUMA_API_BASE_URL=http://localhost:8000
