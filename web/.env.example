# Copy to .env.local and fill in. The same LiveKit project as the agent's .env.

LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the agent_name the worker registers under. The agent uses explicit
# dispatch, so leaving this blank means it never joins the room.
AGENT_NAME=luma-bistro

# Only needed when deploying. /api/token mints LiveKit tokens with no auth, so it
# refuses to run in production unless this is set. Local dev does not need it.
# ALLOW_PUBLIC_DEMO=true
